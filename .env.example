# 站点公开地址：用于 canonical、站点地图、RSS 等绝对链接。
NUXT_SITE_URL=https://blog.example.com

# 图片读取模式：local 使用 public/media/posts；remote 使用图片 manifest 中的远程地址。
# 可选值只能是 local 或 remote。
NUXT_PUBLIC_IMAGE_MODE=local

# Twikoo 评论后端地址或腾讯云 CloudBase 环境 ID；留空时不加载评论。
NUXT_PUBLIC_TWIKOO_ENV_ID=
# 腾讯云 CloudBase 地域；使用完整 HTTPS 后端地址时通常留空。
NUXT_PUBLIC_TWIKOO_REGION=
# Twikoo 浏览器端脚本地址；版本已固定，升级前需确认与后端兼容。
NUXT_PUBLIC_TWIKOO_SRC=https://cdn.jsdelivr.net/npm/twikoo@2.0.17/dist/twikoo.min.js

# Umami 统计脚本地址，例如 https://analytics.example.com/script.js。
# 与 WEBSITE_ID 必须同时填写；任意一项为空时不加载统计。
NUXT_PUBLIC_UMAMI_SRC=
# Umami 后台创建站点后生成的 Website ID。
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# 页脚 GitHub 链接；填写完整公开地址，留空则不显示。
NUXT_PUBLIC_GITHUB_URL=
# 网站主体名称，用于页脚备案信息，例如 Muxui。
NUXT_PUBLIC_SITE_LEGAL_NAME=Muxui
# ICP 备案号；没有备案时留空。
NUXT_PUBLIC_SITE_ICP=
# 公安联网备案号；没有备案时留空。
NUXT_PUBLIC_SITE_GONGAN=

# 以下变量只给 pnpm images:upload 使用，不能加 NUXT_PUBLIC_ 前缀，也不能提交真实密钥。
# 阿里云 OSS AccessKey ID。
IMAGE_OSS_ACCESS_KEY_ID=
# 阿里云 OSS AccessKey Secret。
IMAGE_OSS_ACCESS_KEY_SECRET=
# OSS Bucket 名称。
IMAGE_OSS_BUCKET=
# OSS 地域，例如 oss-cn-hangzhou。
IMAGE_OSS_REGION=oss-cn-hangzhou
# 图片公开访问前缀或绑定的 CDN/自定义域名，不要以 / 结尾。
IMAGE_OSS_PUBLIC_BASE=
