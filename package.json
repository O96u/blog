{
  "name": "blog",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "predev": "node --experimental-strip-types scripts/build-public.ts",
    "dev": "nuxt dev",
    "generate": "node --experimental-strip-types scripts/build-public.ts && nuxt generate",
    "preview": "node scripts/preview-static.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "node --experimental-strip-types scripts/content-check.ts",
    "content:new": "node --experimental-strip-types scripts/content-new.ts",
    "images:process": "node --experimental-strip-types scripts/images-process.ts",
    "images:upload": "node --experimental-strip-types scripts/images-upload.ts",
    "images:verify": "node --experimental-strip-types scripts/images-verify.ts",
    "seo:audit": "node --experimental-strip-types scripts/seo-audit.ts"
  },
  "dependencies": {
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/seo": "6.0.1",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "minisearch": "7.2.0",
    "nuxt": "4.6.4",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/kit": "4.6.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.10.15",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
